# Domyślnie tekst z normalizacją do LF w repozytorium
* text=auto eol=lf

# Kod źródłowy i konfiguracja
*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# Obrazy i archiwa — binarnie, bez konwersji końców wiersza
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.svg  text eol=lf
*.zip  binary
